{
  "name": "ribose-cla",
  "version": "0.1.0",
  "private": true,
  "description": "Ribose CLA \u2014 Contributor License Agreement enforcement for the Ribose GitHub estate (GitHub App)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/riboseinc/cla"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "site"
  ],
  "scripts": {
    "gen": "tsx scripts/gen.ts",
    "typecheck": "npm run gen && tsc --noEmit",
    "test": "npm run gen && vitest run",
    "build": "npm run gen && npm run build -w @riboseinc/cla-site && wrangler deploy --dry-run --config wrangler.example.toml",
    "dev": "npm run gen && wrangler dev --config wrangler.example.toml",
    "site:dev": "npm run dev -w @riboseinc/cla-site",
    "site:build": "npm run build -w @riboseinc/cla-site",
    "site:check": "npm run check -w @riboseinc/cla-site"
  },
  "dependencies": {
    "hono": "^4.13.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0"
  }
}
